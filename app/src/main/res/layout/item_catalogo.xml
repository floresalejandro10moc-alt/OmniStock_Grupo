<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/glass_white_10"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/glass_stroke"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:gravity="center_horizontal">

        <ImageView
            android:id="@+id/imgItemCatalogoIcon"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_marginBottom="12dp"
            android:src="@drawable/caja_omni"
            android:scaleType="fitCenter"
            android:background="@drawable/circle_glass"
            android:padding="12dp"/>

        <TextView
            android:id="@+id/txtItemCatalogoNombre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_high_emphasis"
            android:text="Producto"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginBottom="8dp"/>

        <TextView
            android:id="@+id/txtItemCatalogoPrecio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="$0.00"
            android:textColor="@color/accent_primary"
            android:textStyle="bold"
            android:textSize="16sp"
            android:layout_marginBottom="4dp"/>

        <TextView
            android:id="@+id/txtItemCatalogoStock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Stock: 0"
            android:textColor="@color/text_medium_emphasis"
            android:textSize="12sp"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnItemCatalogoAgregar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agregar"
            android:backgroundTint="@color/accent_primary"
            android:textColor="@color/bg_main"
            android:textAllCaps="false"
            app:cornerRadius="12dp"/>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
