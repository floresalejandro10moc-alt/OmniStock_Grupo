<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/static_background">

    <!-- Big O Decoration -->
    <ImageView
        android:id="@+id/ivBigO_main"
        android:layout_width="600dp"
        android:layout_height="600dp"
        android:layout_marginStart="-300dp"
        android:layout_marginTop="-100dp"
        android:src="@drawable/bg_circle_o"
        android:alpha="0.8"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <TextView
                android:id="@+id/tvNombreUsuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Bienvenido al Sistema"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/text_high_emphasis"
                android:gravity="center"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="40dp"/>

            <Button
                android:id="@+id/btnIrAlInventario"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:text="📦 CATÁLOGO DE PRODUCTOS"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_high_emphasis"
                android:backgroundTint="@color/glass_white_10"
                app:strokeColor="@color/glass_stroke"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="0dp"/>

            <Button
                android:id="@+id/btnAgregarProducto"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:text="➕ REGISTRAR NUEVO PRODUCTO"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_high_emphasis"
                android:backgroundTint="@color/glass_white_10"
                app:strokeColor="@color/glass_stroke"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="0dp"/>

            <Button
                android:id="@+id/btnIrAlCarrito"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:text="🛒 MI CARRITO DE COMPRAS"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_high_emphasis"
                android:backgroundTint="@color/glass_white_10"
                app:strokeColor="@color/glass_stroke"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="0dp"/>

            <Button
                android:id="@+id/btnHistorial"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:text="🧾 HISTORIAL DE FACTURAS"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_high_emphasis"
                android:backgroundTint="@color/glass_white_10"
                app:strokeColor="@color/glass_stroke"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                android:layout_marginBottom="40dp"
                android:elevation="0dp"/>

            <Button
                android:id="@+id/btnGestionCategorias"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:text="📂 GESTIÓN DE CATEGORÍAS"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/text_high_emphasis"
                android:backgroundTint="@color/glass_white_10"
                app:strokeColor="@color/glass_stroke"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                android:layout_marginBottom="16dp"
                android:elevation="0dp"/>

            <Button
                android:id="@+id/btnCerrarSesion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="CERRAR SESIÓN"
                android:textStyle="bold"
                android:padding="15dp"
                android:textColor="#FF8A80"
                android:backgroundTint="@color/glass_white_10"
                app:strokeColor="#FF8A80"
                app:strokeWidth="1dp"
                app:cornerRadius="16dp"
                android:elevation="0dp"/>

        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>