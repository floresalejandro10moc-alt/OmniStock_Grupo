<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@drawable/static_background"
    tools:context=".ui.DetalleFacturaActivity">

    <!-- Big O Decoration -->
    <ImageView
        android:id="@+id/ivBigO_detail"
        android:layout_width="400dp"
        android:layout_height="400dp"
        android:layout_marginEnd="-200dp"
        android:layout_marginTop="-200dp"
        android:src="@drawable/bg_circle_o"
        android:alpha="0.4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Header -->
    <LinearLayout
        android:id="@+id/headerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnVolver"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@android:drawable/ic_menu_revert"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:tint="@color/text_high_emphasis"
            android:contentDescription="Volver"
            android:scaleType="centerInside"
            android:rotation="180"/> 

        <TextView
            android:id="@+id/txtDetalleFacturaTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detalle de Factura #0"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/text_high_emphasis"
            android:layout_marginStart="16dp"/>
    </LinearLayout>

    <!-- Content Scroller for Customer Info & Lists -->
    <LinearLayout
        android:id="@+id/infoContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toBottomOf="@id/headerContainer"
        app:layout_constraintBottom_toTopOf="@id/footerContainer">

        <!-- Client Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/glass_white_10"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/glass_stroke"
            app:strokeWidth="1dp">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/txtDetalleFacturaCliente"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cliente: Cargando..."
                    android:textColor="@color/text_high_emphasis"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtDetalleFacturaCedula"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="C.I.: Cargando..."
                    android:textColor="@color/text_high_emphasis"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtDetalleFacturaDireccion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dir: Cargando..."
                    android:textColor="@color/text_high_emphasis"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtDetalleFacturaTelefono"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Telf: Cargando..."
                    android:textColor="@color/text_high_emphasis"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/txtDetalleFacturaFecha"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fecha: Cargando..."
                    android:textColor="@color/text_high_emphasis"
                    android:textSize="14sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Productos Comprados:"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_high_emphasis"
            android:layout_marginBottom="8dp"/>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerDetalleProductos"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- Footer Totals -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/footerContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:cardBackgroundColor="@color/glass_white_10"
        app:cardCornerRadius="12dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/glass_stroke"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/txtDetalleSubtotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="Subtotal: $0.00"
                android:textColor="@color/text_medium_emphasis"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtDetalleIva15"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="IVA (15%): $0.00"
                android:textColor="@color/text_medium_emphasis"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtDetalleIva12"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="IVA (12%): $0.00"
                android:textColor="@color/text_medium_emphasis"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtDetalleImpSantuario"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="Imp. Santuario (5%): $0.00"
                android:textColor="@color/text_medium_emphasis"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtDetalleFacturaTotal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="Total Pagado: $0.00"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_high_emphasis"
                android:layout_marginTop="8dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>