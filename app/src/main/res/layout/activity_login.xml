<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/static_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <!-- Big O Decoration (Top-Left) -->
        <ImageView
            android:id="@+id/ivBigO"
            android:layout_width="400dp"
            android:layout_height="400dp"
            android:layout_marginTop="-100dp"
            android:layout_marginStart="-100dp"
            android:src="@drawable/bg_circle_o"
            android:alpha="0.6"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Welcome Header -->
        <LinearLayout
            android:id="@+id/welcomeHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="32dp"
            android:layout_marginTop="60dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bienvenido a "
                android:textSize="30sp"
                android:textStyle="normal"
                android:textColor="@color/text_high_emphasis"/>

            <ImageView
                android:id="@+id/miImagenView"
                android:layout_width="300dp"
                android:layout_height="60dp"
                android:layout_gravity="start"
                android:layout_marginBottom="14dp"
                android:scaleType="fitCenter"
                android:src="@drawable/omnistock_letras" />

        </LinearLayout>

        <!-- Floating Image (Anchored in middle) -->
        <ImageView
            android:id="@+id/cajaView"
            android:layout_width="200dp"
            android:layout_height="200dp"
            android:src="@drawable/caja_omni"
            android:scaleType="fitCenter"
            android:alpha="0.8"
            android:layout_marginEnd="0dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHorizontal_bias="1.0"
            app:layout_constraintTop_toBottomOf="@id/welcomeHeader"
            app:layout_constraintBottom_toTopOf="@id/loginCard"
            app:layout_constraintVertical_bias="0.5" />

        <!-- Login Card (Bottom) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/loginCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/glass_white_10"
            app:cardCornerRadius="32dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/glass_stroke"
            app:strokeWidth="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="-20dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cajaView"
            app:layout_constraintVertical_bias="1.0">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:paddingTop="50dp"
                android:paddingBottom="100dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="30dp"
                    android:fontFamily="@font/catamaran"
                    android:text="@string/login_title"
                    android:textColor="@color/text_high_emphasis"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_username"
                    android:textColorHint="@color/text_medium_emphasis"
                    app:boxBackgroundColor="@color/glass_white_10"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxStrokeWidth="0dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etUsuario"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionNext"
                        android:inputType="text"
                        android:textColor="@color/text_high_emphasis"/>
                </com.google.android.material.textfield.TextInputLayout>

                <Space android:layout_width="match_parent" android:layout_height="16dp"/>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="@string/hint_password"
                    android:textColorHint="@color/text_medium_emphasis"
                    app:boxBackgroundColor="@color/glass_white_10"
                    app:boxCornerRadiusTopStart="16dp"
                    app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp"
                    app:boxCornerRadiusBottomEnd="16dp"
                    app:boxStrokeWidth="0dp"
                    app:passwordToggleEnabled="true"
                    app:passwordToggleTint="@color/accent_primary">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etClave"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:inputType="textPassword"
                        android:textColor="@color/text_high_emphasis"/>
                </com.google.android.material.textfield.TextInputLayout>

                <Button
                    android:id="@+id/btnIngresar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="32dp"
                    android:text="@string/btn_login_text"
                    android:backgroundTint="@color/accent_primary"
                    android:textColor="@color/bg_main"
                    android:padding="16dp"
                    app:cornerRadius="30dp"/>

                <TextView
                    android:id="@+id/tvIrARegistro"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:fontFamily="@font/catamaran_bold"
                    android:text="@string/signup_prompt"
                    android:textColor="@color/text_medium_emphasis"
                    android:textSize="16sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
