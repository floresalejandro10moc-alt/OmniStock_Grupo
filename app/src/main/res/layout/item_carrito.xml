<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardViewProducto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardBackgroundColor="@color/glass_white_10"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/glass_stroke"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <!-- Quantity Controls (Left) -->
        <LinearLayout
            android:id="@+id/layoutCantidad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_circle_o"
            android:backgroundTint="@color/glass_white_10"
            android:padding="4dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageButton
                android:id="@+id/btnMenos"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_delete"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Disminuir cantidad"
                app:tint="@color/text_high_emphasis"
                android:padding="4dp"/>

            <TextView
                android:id="@+id/txtCantidad"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="1"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_high_emphasis"
                android:layout_marginHorizontal="8dp"/>

            <ImageButton
                android:id="@+id/btnMas"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@android:drawable/ic_input_add"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Aumentar cantidad"
                app:tint="@color/text_high_emphasis"
                android:padding="4dp"/>
        </LinearLayout>

        <!-- Product Name (Middle-Top) -->
        <TextView
            android:id="@+id/txtNombreProducto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="Nombre del Producto"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_high_emphasis"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/layoutCantidad"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/txtPrecioProducto"
            app:layout_constraintBottom_toTopOf="@id/txtDetalleImpuesto"
            app:layout_constraintVertical_chainStyle="packed"/>

        <!-- Tax/Detail Info (Middle-Bottom) -->
        <TextView
            android:id="@+id/txtDetalleImpuesto"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            tools:text="IVA: 12%"
            android:textSize="12sp"
            android:textColor="@color/text_medium_emphasis"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="@id/txtNombreProducto"
            app:layout_constraintTop_toBottomOf="@id/txtNombreProducto"
            app:layout_constraintEnd_toEndOf="@id/txtNombreProducto"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <!-- Price (Right) -->
        <TextView
            android:id="@+id/txtPrecioProducto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="$125.50"
            android:textSize="18sp"
            android:textColor="@color/text_high_emphasis"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>